# ---- Environment ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# آدرس عمومی سایت برای canonical و sitemap
SITE_URL=https://your-domain.com

# ---- Database ----
# موتور دیتابیس:
#   sqlite (پیش‌فرض) → دیتابیس داخلی فایل‌محور، بدون نیاز به سرویس جداگانه (مناسب اجرای لوکال)
#   mysql            → MySQL/MariaDB (مناسب استقرار تولیدی)
DB_CLIENT=sqlite
# مسیر فایل دیتابیس SQLite (نسبی به پوشه server یا مطلق)
SQLITE_PATH=data/sadra.db

# ---- Database (MySQL — فقط زمانی که DB_CLIENT=mysql باشد) ----
# دیتابیس در اولین اجرا به‌صورت خودکار ساخته می‌شود (CREATE DATABASE IF NOT EXISTS)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sadra
MYSQL_CONNECTION_LIMIT=10

# ---- JWT ----
# کلید امضای توکن (در محیط واقعی حتماً عوض کنید)
JWT_SECRET=change-me-to-a-very-long-secret-key-in-production
JWT_EXPIRES_IN=7d

# ---- OTP / SMS ----
# حالت ارسال کد تأیید:
#   sms    -> ارسال واقعی از طریق سرویس SMS (در نسخه فعلی از طریق SmsProvider توسعه)
#   console-> چاپ کد در کنسول سرور (development)
#   fixed  -> کد ثابت 123456 برای توسعه
OTP_MODE=console
OTP_FIXED_CODE=123456
OTP_TTL_MINUTES=5

# ---- Auth mode ----
# otp   -> ورود با شماره موبایل + کد تأیید (پیش‌فرض، امن)
# phone -> ورود فقط با شماره موبایل، بدون کد (توسعه/تست)
AUTH_MODE=otp

# ---- Admin ----
# اطلاعات حساب مدیر پنل (ورود از /admin با نام کاربری و رمز عبور)
ADMIN_PHONE=09120000000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- AI Stylist (اختیاری) ----
# به‌صورت پیش‌فرض موتور پیشنهاد محلی (بدون نیاز به سرویس خارجی) فعال است.
# برای استفاده از یک LLM سازگار با OpenAI، مقادیر زیر را تنظیم کنید (در صورت خطا، موتور محلی جایگزین می‌شود).
# STYLIST_LLM_URL=https://api.openai.com/v1/chat/completions
# STYLIST_LLM_KEY=sk-...
# STYLIST_LLM_MODEL=gpt-4o-mini
# نرخ تقریبی تبدیل دلار به تومان (برای تفکیک بودجه‌ی نوشته‌شده به دلار در متن)
# STYLIST_USD_RATE=100000